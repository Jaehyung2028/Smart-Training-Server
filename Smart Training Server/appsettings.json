{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Operations": {
    "OpenBrowserOnStart": true,
    "PersistHistory": true,
    "HistoryPath": "Data/operations-history.json"
  },
  "Server": {
    "Name": "Smart Training Server",
    "Port": 5229
  },
  "Auth": {
    "NameMinLength": 2,
    "NameMaxLength": 20,
    "AllowDuplicateName": false
  },
  "Room": {
    "AdvertisedAddress": "",
    "ServerExecutablePath": "RoomServer/Smart Training Room.exe",
    "ServerApiBaseUrl": "http://127.0.0.1:5229",
    "ServerReadyTimeoutSeconds": 60,
    "MinUsers": 1,
    "MaxUsers": 8,
    "NameMinLength": 2,
    "NameMaxLength": 30,
    "AllowDuplicateName": true
  }
}
