{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Server": {
    "Name": "Smart Training Server",
    "Port": 5228
  },

  "Auth": {
    "NameMinLength": 2,
    "NameMaxLength": 20,
    "AllowDuplicateName": false
  },

  "Lobby": {
    "MaxCount": 10,
    "NameMinLength": 2,
    "NameMaxLength": 10,
    "AllowDuplicateName": false
  },

  "Room": {
    "AdvertisedAddress": "",
    "ServerExecutablePath": "RoomServer/Smart Training Room.exe",
    "ServerApiBaseUrl": "http://127.0.0.1:5229",
    "ServerReadyTimeoutSeconds": 60,
    "MinUsers": 1,
    "MaxUsers": 8,
    "NameMinLength": 2,
    "NameMaxLength": 30,
    "PasswordMaxLength": 20,
    "AllowDuplicateName": true
  },

  "Simulation": {
    "TickRate":  30
  }
}
